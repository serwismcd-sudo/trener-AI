# Skopiuj ten plik jako .env i uzupelnij wlasnymi danymi.
# Plik .env zostaje wylacznie na Twoim komputerze - nigdy go nie wysylaj i nie commituj.

# Klucz do API Claude - https://console.anthropic.com  (Settings -> API Keys)
ANTHROPIC_API_KEY=sk-ant-...

# Logowanie do Garmin Connect (te same dane co w aplikacji Garmin Connect)
GARMIN_EMAIL=twoj@email.pl
GARMIN_PASSWORD=twoje-haslo

# --- opcjonalne ---
# Model Claude. Domyslnie claude-opus-5 (najlepsza jakosc planow).
# Tansza alternatywa: claude-sonnet-5
# ANTHROPIC_MODEL=claude-opus-5

# Gdzie trzymac token sesji Garmina (domyslnie ~/.garminconnect)
# GARMINTOKENS=C:\Users\Msi\.garminconnect
